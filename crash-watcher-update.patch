@@ -24,6 +24,23 @@ def yellow_green_green_yellow(reading: GridReading | None) -> bool:
     return False
 
 
+def same_row_yellow_repeat(reading: GridReading | None, gap: int = 4) -> bool:
+    """True when the same row is yellow in two columns exactly `gap` apart.
+
+    The user reads that repetition as the next column turning up yellow in the
+    same row, so the following round is worth a yellow bet. It holds for any
+    row, not only the third one.
+    """
+    if reading is None or gap < 1:
+        return False
+    for row in range(reading.rows):
+        for column in range(reading.columns - gap):
+            if (reading.color_at(column, row) == "YELLOW"
+                    and reading.color_at(column + gap, row) == "YELLOW"):
+                return True
+    return False
+
+
