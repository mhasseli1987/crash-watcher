 crash_watcher/desktop/clicker.py              | 69 ++++++++++++++++++-
 crash_watcher/desktop/ui.py                   |  5 ++
 tests/test_desktop.py                         | 16 +++++
 ...31\201\330\247\330\261\330\263\333\214.md" |  2 +-
 5 files changed, 93 insertions(+), 4 deletions(-)

