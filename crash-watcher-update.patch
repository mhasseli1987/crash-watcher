+"""Shape signals read from the game's colour-dot trend chart.
+
+The chart is column-major (see color_grid): the newest dot is the top-left cell
+and history fills down a column before moving one column to the right. A signal
+is therefore a shape of adjacent cells, exactly as the user sees it.
+"""
+from __future__ import annotations
+
+from .color_grid import GridReading
+
+
+def two_reds_then_two_yellows(reading: GridReading | None) -> bool:
+    """True when a column holds two reds and the next column holds two yellows."""
+    if reading is None:
+        return False
+    for column in range(reading.columns - 1):
+        left = (reading.color_at(column, 0), reading.color_at(column, 1))
+        right = (reading.color_at(column + 1, 0), reading.color_at(column + 1, 1))
+        if left == ("RED", "RED") and right == ("YELLOW", "YELLOW"):
+            return True
+    return False
